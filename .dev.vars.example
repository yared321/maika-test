TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
DEMO_BYPASS_VERIFY=false
MAIKA_RPPG_UPSTREAM=
MAIKA_PUBLIC_KEY=
MAIKA_CAPTCHA_TOKEN=
CORS_ALLOW_ORIGIN=*
MAIKA_BACKEND_URL=https://maika-backend-service.onrender.com
MAIKA_BACKEND_API_KEY=
